@page "/admin/categories/{Action}/{Id?}"
@using HostingApplication.Client.Admin.Products.Services
@using HostingApplication.Client.Models
@inject AdminCategoryService AdminCategoryService
@inject NavigationManager Navigation

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">@(IsEdit ? "Edit" : "Add") Category</MudText>
    <EditForm Model="category" OnValidSubmit="HandleSubmit">
        <MudTextField @bind-Value="category.Name" Label="Name" Required="true" />
        <MudTextField @bind-Value="category.Description" Label="Description" />
        <MudTextField @bind-Value="category.Slug" Label="Slug" Required="true" />
        @* <MudCheckBox @bind-Checked="category.IsActive" Label="Active" /> *@
        <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Success">@(IsEdit ? "Update" : "Create")</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public string Action { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private CategoryDto category = new CategoryDto();
    private bool IsEdit => Action == "edit";

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit && Id.HasValue)
        {
            category = await AdminCategoryService.GetCategoryByIdAsync(Id.Value) ?? new CategoryDto();
        }
    }

    private async Task HandleSubmit()
    {
        bool success = IsEdit
            ? await AdminCategoryService.UpdateCategoryAsync(category)
            : await AdminCategoryService.CreateCategoryAsync(category);

        if (success)
        {
            Navigation.NavigateTo("/admin/categories");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/categories");
    }
}
