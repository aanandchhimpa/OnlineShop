@page "/admin/brands/{Action}/{Id?}"
@using HostingApplication.Client.Admin.Products.Services
@using HostingApplication.Client.Models
@inject AdminBrandService BrandService
@inject NavigationManager Navigation

<h3>@(IsEdit ? "Edit" : "Add") Brand</h3>

@if (brand == null)
{
    <p>Loading...</p>
}
else
{
    <form @onsubmit="HandleSubmit">
        <div class="mb-3">
            <label class="form-label">Brand Name</label>
            <input class="form-control" @bind="brand.Name" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Slug</label>
            <input class="form-control" @bind="brand.Slug" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="brand.Description"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Active</label>
            <input type="checkbox" @bind="brand.IsActive" />
        </div>
        <button type="submit" class="btn btn-success">@(IsEdit ? "Update" : "Create")</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </form>
}

@code {
    [Parameter] public string Action { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private BrandDto brand = new BrandDto();
    private bool IsEdit => Action == "edit";

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit && Id.HasValue)
        {
            brand = await BrandService.GetBrandByIdAsync(Id.Value) ?? new BrandDto();
        }
    }

    private async Task HandleSubmit()
    {
        bool success = IsEdit
            ? await BrandService.UpdateBrandAsync(brand)
            : await BrandService.CreateBrandAsync(brand);

        if (success)
        {
            Navigation.NavigateTo("/admin/brands");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/brands");
    }
}
